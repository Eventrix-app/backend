    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"organizerId\": \"{{organizerId}}\",\n  \"title\": \"Tech Conference 2024\",\n  \"description\": \"Annual technology conference featuring latest trends\",\n  \"categoryId\": \"<category-uuid>\",\n  \"venueName\": \"Tech Center\",\n  \"venueAddress\": \"123 Innovation Street, San Francisco, CA\",\n  \"eventDate\": \"2024-12-15\",\n  \"startTime\": \"09:00:00\",\n  \"endTime\": \"17:00:00\",\n  \"pricePerTicket\": 99.99,\n  \"totalCapacity\": 500,\n  \"availableTickets\": 500,\n  \"status\": \"active\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data && data.id) { pm.environment.set('eventId', data.id); }"] } }]
        },
        { "name": "List All Events", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] } } },
        { "name": "Get Event By ID", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}"] } } },
        { "name": "Update Event",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Tech Conference 2024 - Updated\",\n  \"description\": \"Updated description\",\n  \"pricePerTicket\": 89.99,\n  \"availableTickets\": 450\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}"] }
          }
        },
        { "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}"] }
          }
        },
        { "name": "Enroll Participant",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/enroll", "host": ["{{baseUrl}}"], "path": ["events","{{eventId}}","enroll"] }
          }
        },
        { "name": "Find Events By Organizer",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" } ],
            "url": { "raw": "{{baseUrl}}/events/organizer/{{organizerId}}", "host": ["{{baseUrl}}"], "path": ["events","organizer","{{organizerId}}"] }
          }
        }
      ]
    }
  ]
