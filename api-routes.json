              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Conference\",\n  \"emoji\": \"🎪\",\n  \"colorHex\": \"#FF5733\",\n  \"description\": \"Professional conferences and networking events\"\n}",
              "options": { "raw": { "language": "json" } }
            },
