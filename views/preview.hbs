<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-tsx.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet">
    <style>
        .component-card {
            transition: all 0.3s ease;
        }
        .component-card:hover {
            transform: translateY(-2px);
        }
        .code-container {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        .code-container.expanded {
            max-height: 600px;
        }
    </style>
</head>
<body class="bg-gray-50">
    <div class="min-h-screen">
        <!-- Header -->
        <header class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <div class="flex items-center">
                        <h1 class="text-2xl font-bold text-gray-900">Eventrix Component Preview</h1>
                    </div>
                    <div class="flex items-center space-x-4">
                        <span class="text-sm text-gray-500">Total Components: {{components.length}}</span>
                        <button onclick="toggleAllCode()" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                            Toggle All Code
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Filter Section -->
            <div class="mb-8 bg-white rounded-lg shadow p-6">
                <div class="flex flex-wrap gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Filter by Type:</label>
                        <select id="typeFilter" onchange="filterComponents()" class="border border-gray-300 rounded-md px-3 py-2">
                            <option value="">All Types</option>
                            <option value="component">Components</option>
                            <option value="screen">Screens</option>
                            <option value="navigation">Navigation</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Filter by Category:</label>
                        <select id="categoryFilter" onchange="filterComponents()" class="border border-gray-300 rounded-md px-3 py-2">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                    <div class="flex-1">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Search:</label>
                        <input type="text" id="searchInput" onkeyup="filterComponents()" placeholder="Search components..." 
                               class="w-full border border-gray-300 rounded-md px-3 py-2">
                    </div>
                </div>
            </div>

            <!-- Components Grid -->
            <div id="componentsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {{#each components}}
                <div class="component-card bg-white rounded-lg shadow-md overflow-hidden" 
                     data-type="{{type}}" 
                     data-category="{{category}}" 
                     data-name="{{name}}">
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">{{name}}</h3>
                                <div class="flex gap-2 mt-1">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        {{type}}
                                    </span>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        {{category}}
                                    </span>
                                </div>
                            </div>
                            <button onclick="toggleCode('{{name}}')" class="text-gray-400 hover:text-gray-600">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                                </svg>
                            </button>
                        </div>
                        
                        <div class="text-sm text-gray-600 mb-3">
                            <p class="font-medium">Path:</p>
                            <code class="bg-gray-100 px-2 py-1 rounded text-xs">{{path}}</code>
                        </div>

                        {{#if exports.length}}
                        <div class="text-sm text-gray-600 mb-3">
                            <p class="font-medium">Exports:</p>
                            <div class="flex flex-wrap gap-1">
                                {{#each exports}}
                                <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-xs">{{this}}</span>
                                {{/each}}
                            </div>
                        </div>
                        {{/if}}

                        {{#if imports.length}}
                        <div class="text-sm text-gray-600 mb-4">
                            <p class="font-medium">Imports ({{imports.length}}):</p>
                            <div class="text-xs text-gray-500">
                                {{#each imports}}
                                <span class="mr-2">{{this}}</span>
                                {{/each}}
                            </div>
                        </div>
                        {{/if}}

                        <div class="code-container" id="code-{{name}}">
                            <div class="mt-4">
                                <pre><code class="language-tsx">{{content}}</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </main>
    </div>

    <script>
        // Initialize category filter
        document.addEventListener('DOMContentLoaded', function() {
            const categories = [...new Set({{#each components}}'{{category}}'{{#unless @last}},{{/unless}}{{/each}})];
            const categoryFilter = document.getElementById('categoryFilter');
            
            categories.forEach(category => {
                const option = document.createElement('option');
                option.value = category;
                option.textContent = category;
                categoryFilter.appendChild(option);
            });
        });

        function filterComponents() {
            const typeFilter = document.getElementById('typeFilter').value.toLowerCase();
            const categoryFilter = document.getElementById('categoryFilter').value.toLowerCase();
            const searchInput = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.component-card');

            cards.forEach(card => {
                const type = card.dataset.type.toLowerCase();
                const category = card.dataset.category.toLowerCase();
                const name = card.dataset.name.toLowerCase();

                const matchesType = !typeFilter || type === typeFilter;
                const matchesCategory = !categoryFilter || category === categoryFilter;
                const matchesSearch = !searchInput || name.includes(searchInput);

                if (matchesType && matchesCategory && matchesSearch) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function toggleCode(componentName) {
            const codeContainer = document.getElementById(`code-${componentName}`);
            codeContainer.classList.toggle('expanded');
            
            // Re-highlight code when expanded
            if (codeContainer.classList.contains('expanded')) {
                Prism.highlightAllUnder(codeContainer);
            }
        }

        function toggleAllCode() {
            const codeContainers = document.querySelectorAll('.code-container');
            const allExpanded = Array.from(codeContainers).every(container => 
                container.classList.contains('expanded')
            );

            codeContainers.forEach(container => {
                if (allExpanded) {
                    container.classList.remove('expanded');
                } else {
                    container.classList.add('expanded');
                    Prism.highlightAllUnder(container);
                }
            });
        }
    </script>
</body>
</html>
