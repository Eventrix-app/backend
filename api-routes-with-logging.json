          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('\\n🔐 LOGIN USER');",
                  "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
                  "console.log('📍 Endpoint: POST /auth/login');",
                  "console.log('⏱️  Response Time: ' + pm.response.responseTime + 'ms');",
                  "console.log('📊 Status Code: ' + pm.response.code);",
                  "const loginData = pm.response.json();",
                  "if (loginData && (loginData.accessToken || loginData.token)) {",
                  "  const token = loginData.accessToken || loginData.token;",
                  "  pm.collectionVariables.set('accessToken', token);",
                  "  pm.environment.set('accessToken', token);",
                  "  if (loginData.role) pm.environment.set('userRole', loginData.role);",
                  "  console.log('✅ Login Successful');",
                  "  console.log('👤 Email: ' + loginData.email);",
                  "  console.log('🔐 Role: ' + (loginData.role || 'user'));",
                  "  console.log('🆔 User ID: ' + loginData.id);",
                  "  console.log('⏰ Token Expires In: ' + loginData.expiresIn + 's');",
                  "  console.log('🔑 Token (First 30 chars): ' + token.substring(0, 30) + '...');",
                  "} else {",
                  "  console.log('❌ Login Failed');",
                  "  console.log('⚠️  Error: ' + loginData.message);",
                  "}",
